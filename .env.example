# Copier ce fichier vers .env puis remplir les deux valeurs.
# .env est ignoré par git, .env.example non : ne jamais mettre de vraie clé ici.
#
# Les deux se trouvent dans le tableau de bord Supabase, Project settings puis
# API. La clé « anon » est publique par conception, c'est RLS qui protège les
# données, pas le secret de cette clé. La clé « service_role », elle, ne doit
# jamais approcher le client : elle contourne RLS et n'a sa place que dans les
# secrets des Edge Functions.
#
# Le préfixe EXPO_PUBLIC_ est nécessaire pour que la valeur soit injectée dans le
# bundle. Il signale aussi, à la lecture, que la valeur est publique.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique de la PWA, sans barre oblique finale. Exemple :
# https://cairn.pages.dev
#
# Trois choses en dépendent, et c'est pourquoi elle est ici plutôt que recopiée
# à trois endroits : le lien déposé dans les évènements Google Agenda, les
# `intentFilters` d'app.config.js qui font ouvrir ce lien par l'application, et
# le fichier généré par `npm run assetlinks`.
#
# Vide, tout continue de fonctionner : les évènements ne peuvent simplement pas
# être créés, et l'application ne s'enregistre pas comme ouvreuse de ces liens.
EXPO_PUBLIC_WEB_URL=

# Identifiant du client OAuth Google, pour l'accès à l'agenda. Ce n'est pas un
# secret : un identifiant de client est public par conception, et le secret
# associé vit dans les Edge Functions, jamais ici.
#
# Un seul client, de type « Web », pour l'APK comme pour la PWA. Un client
# « Android » aurait semblé plus naturel, mais Google y a déprécié les schémas
# privés : la redirection passe donc par un lien d'application https, remis à
# l'application installée grâce à assetlinks.json.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Empreinte SHA-256 du certificat de signature Android, telle que rendue par
# `eas credentials` (plateforme Android, Keystore). Format attendu : des octets
# en hexadécimal séparés par des deux-points.
#
# Sert à `npm run assetlinks`, et ce fichier n'est plus un confort : sans lui,
# Android refuse de vérifier que l'application a le droit d'ouvrir les liens du
# domaine. Les liens de note partiraient au navigateur — désagréable mais
# acceptable — et surtout le retour du consentement Google s'y perdrait, ce qui
# empêche purement et simplement de connecter l'agenda depuis l'APK.
ANDROID_CERT_SHA256=
