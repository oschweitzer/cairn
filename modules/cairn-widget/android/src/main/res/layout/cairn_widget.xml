<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed header, list below.

  The header is a sibling of the ListView, not its first row: slipped into the
  list, it would disappear upwards on the first scroll and the create buttons
  would be unreachable on a long list.
-->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/cairn_widget_background">

  <LinearLayout
    android:id="@+id/cairn_widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- The current filter, on the left: it is read first, and it says what the
         list is showing. The button that cycles it wraps around it. -->
    <LinearLayout
      android:id="@+id/cairn_widget_filter_button"
      android:layout_width="0dp"
      android:layout_height="40dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:background="@drawable/cairn_widget_pill"
      android:contentDescription="@string/cairn_widget_filter_hint">

      <TextView
        android:id="@+id/cairn_widget_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="@color/cairn_text_secondary" />
    </LinearLayout>

    <!-- 48 points across: Android's touch-target floor, and a widget is tapped
         with a thumb on a crowded home screen. -->
    <TextView
      android:id="@+id/cairn_widget_new_note"
      android:layout_width="48dp"
      android:layout_height="40dp"
      android:layout_marginStart="6dp"
      android:gravity="center"
      android:text="@string/cairn_widget_new_note_glyph"
      android:textSize="20sp"
      android:textColor="@color/cairn_text_onAccent"
      android:background="@drawable/cairn_widget_accent_pill"
      android:contentDescription="@string/cairn_widget_new_note" />

    <TextView
      android:id="@+id/cairn_widget_new_list"
      android:layout_width="48dp"
      android:layout_height="40dp"
      android:layout_marginStart="6dp"
      android:gravity="center"
      android:text="@string/cairn_widget_new_list_glyph"
      android:textSize="16sp"
      android:textColor="@color/cairn_text_primary"
      android:background="@drawable/cairn_widget_pill"
      android:contentDescription="@string/cairn_widget_new_list" />
  </LinearLayout>

  <!--
    An ImageView and not a View: `RemoteViews` accepts only a closed set of
    classes, those annotated @RemoteView, and `android.view.View` is not among
    them. The package builds without a word, then the launcher refuses to inflate
    the layout — the widget shows up as "couldn't load widget" instead.
  -->
  <ImageView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:contentDescription="@null"
    android:background="@color/cairn_line_hairline" />

  <ListView
    android:id="@+id/cairn_widget_list"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:divider="@null"
    android:dividerHeight="0dp"
    android:scrollbars="none" />

  <TextView
    android:id="@+id/cairn_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:padding="16dp"
    android:textSize="13sp"
    android:textColor="@color/cairn_text_muted"
    android:text="@string/cairn_widget_empty" />
</LinearLayout>
