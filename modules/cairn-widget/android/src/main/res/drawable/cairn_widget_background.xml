<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's background. The corner is a resource rather than a figure: from
     Android 12 the launcher masks the widget with a radius of its own, and ours
     has to agree with it or the border is cut away at the corners. See
     values/dimens.xml and values-v31/dimens.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/cairn_surface_card" />
  <corners android:radius="@dimen/cairn_widget_radius" />
  <stroke android:width="1dp" android:color="@color/cairn_line_hairline" />
</shape>
