<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's declaration for the launcher's picker.

  `resizeMode` on both axes: a list of notes has no correct size, it has the size
  its owner gives it. The default covers three cells by three, enough to read
  four or five notes without scrolling.

  `updatePeriodMillis` is zero on purpose: the content only changes when the app
  writes it, and a periodic wake-up would spend battery re-reading an unchanged
  file.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="180dp"
  android:minHeight="180dp"
  android:targetCellWidth="3"
  android:targetCellHeight="3"
  android:minResizeWidth="110dp"
  android:minResizeHeight="110dp"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen"
  android:initialLayout="@layout/cairn_widget"
  android:description="@string/cairn_widget_description"
  android:updatePeriodMillis="0" />
