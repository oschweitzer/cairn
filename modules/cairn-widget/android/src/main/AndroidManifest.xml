<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Le manifeste d'une bibliothèque est fusionné dans celui de l'application par
    Gradle. C'est ce qui permet à ce module de déclarer son fournisseur de widget
    sans qu'un plugin de configuration ait à réécrire le manifeste de l'app.
  -->
  <application>
    <receiver
      android:name=".CairnWidgetProvider"
      android:exported="true"
      android:label="@string/cairn_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/cairn_widget_info" />
    </receiver>

    <!--
      Le service qui alimente la liste. `BIND_REMOTEVIEWS` est une permission de
      signature système : elle garantit que seul le lanceur peut s'y connecter,
      et non n'importe quelle application installée.
    -->
    <service
      android:name=".CairnWidgetService"
      android:permission="android.permission.BIND_REMOTEVIEWS"
      android:exported="false" />
  </application>
</manifest>
