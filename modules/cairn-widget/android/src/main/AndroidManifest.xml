<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    A library's manifest is merged into the app's by Gradle. That is what lets
    this module declare its widget provider without a config plugin having to
    rewrite the app's manifest.
  -->
  <application>
    <receiver
      android:name=".CairnWidgetProvider"
      android:exported="true"
      android:label="@string/cairn_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/cairn_widget_info" />
    </receiver>

    <!--
      The service that feeds the list. `BIND_REMOTEVIEWS` is a system signature
      permission: it guarantees that only the launcher can bind to it, and not
      any installed app.
    -->
    <service
      android:name=".CairnWidgetService"
      android:permission="android.permission.BIND_REMOTEVIEWS"
      android:exported="false" />
  </application>
</manifest>
